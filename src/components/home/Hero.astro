---
import Mark from '../intro/Mark.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { salon } from '../../data/salon';
---

<section class="hero" aria-labelledby="hero-title">
  <canvas class="sparks" aria-hidden="true"></canvas>

  <div class="hero__inner container">
    <Mark />

    <div class="lettering">
      <p class="lettering__name reveal">{salon.owner}</p>
      <p class="lettering__brand reveal">
        <span>{salon.name}</span>
      </p>
      <p class="lettering__tagline reveal">Salon kosmetologiczny w Lubinie</p>
    </div>

    <div class="divider reveal" aria-hidden="true"></div>

    <h1 id="hero-title" class="hero__title h1 reveal">
      Twoja chwila spokoju. <span>Pielęgnacja dobrana do&nbsp;Ciebie.</span>
    </h1>
    <p class="hero__lead lead reveal">
      Zapraszam na Head Spa, konsultacje trychologiczne i zabiegi, które dobieram po rozmowie z Tobą. Spokojnie, bez
      pośpiechu, przy ul. Odrodzenia w Lubinie.
    </p>

    <div class="btn-row hero__actions reveal">
      <Button href={salon.booksy} external>
        Umów wizytę
      </Button>
      <Button href="#oferta" variant="ghost">
        Poznaj zabiegi
      </Button>
    </div>

    <button type="button" class="replay reveal">
      <Icon name="replay" />
      Odtwórz lot ponownie
    </button>
  </div>

  <a class="hero__scroll reveal" href="#o-salonie">
    <span class="visually-hidden">Przewiń do opisu salonu</span>
  </a>
</section>

<script>
  import { initIntro } from '../../scripts/intro/intro.js';

  initIntro();
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-block: calc(var(--header-h) + 1rem) clamp(4rem, 9svh, 6.5rem);
    text-align: center;
  }

  /* złoty ślad za ptakiem */
  .sparks {
    position: fixed;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Napis pod logo: imię i nazwisko złotym gradientem w kroju z logo, nazwa salonu między liniami,
     niżej drobno salon i miasto. Lewe wcięcie równe odstępowi liter wyrównuje środek napisu. */
  .lettering {
    margin-top: clamp(1.25rem, 3.5svh, 2.25rem);
  }

  .lettering__name {
    padding-left: 0.16em;
    color: var(--gold-mid);
    font-family: var(--f-display);
    font-size: clamp(1.75rem, 1.3rem + 2vw, 2.6rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* Gradient przycięty do liter maluje się tylko w polu elementu, a ogonek J i akcent nad Ó z niego wystają,
     więc pole jest powiększone w pionie, a ujemny margines oddaje to miejsce. */
  @supports (background-clip: text) {
    .lettering__name {
      margin-block: -0.25em;
      padding-block: 0.25em;
      background: var(--gold-gradient);
      background-clip: text;
      color: transparent;
    }
  }

  .lettering__brand {
    display: flex;
    gap: 1.1rem;
    align-items: center;
    justify-content: center;
    margin-top: 0.9rem;
    color: var(--gold-mid);
    font-family: var(--f-label);
    font-size: 0.8rem;
    line-height: 1.2;
    letter-spacing: 0.46em;
    text-transform: uppercase;
  }

  .lettering__brand span {
    padding-left: 0.46em;
  }

  .lettering__brand::before,
  .lettering__brand::after {
    content: '';
    width: 3.5rem;
    height: 1px;
    background: linear-gradient(90deg, rgb(178 138 77 / 0%), var(--gold));
  }

  .lettering__brand::after {
    background: linear-gradient(90deg, var(--gold), rgb(178 138 77 / 0%));
  }

  .lettering__tagline {
    margin-top: 0.8rem;
    padding-left: 0.3em;
    color: var(--mute);
    font-family: var(--f-label);
    font-size: 0.69rem;
    line-height: 1.9;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .divider {
    width: min(15rem, 50vw);
    height: 1px;
    margin-block: clamp(1.4rem, 3.6svh, 2.4rem);
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
  }

  .hero__title {
    font-size: clamp(2.2rem, 1.5rem + 3.2vw, 4.4rem);
  }

  .hero__title span {
    display: block;
  }

  .hero__lead {
    max-width: 36rem;
    margin-top: clamp(1rem, 2.4svh, 1.5rem);
    color: var(--text);
  }

  .hero__actions {
    justify-content: center;
    margin-top: clamp(1.75rem, 4svh, 2.5rem);
  }

  /* „Odtwórz lot ponownie”: widoczny tylko wtedy, gdy animacja działa (klasa .animated z intro.js) */
  .replay {
    display: none;
    gap: 0.6rem;
    align-items: center;
    min-height: 2.75rem;
    margin-top: clamp(1rem, 3svh, 1.75rem);
    padding: 0.5rem 0.25rem;
    border: 0;
    background: none;
    color: var(--mute);
    font-family: var(--f-label);
    font-size: 0.66rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color var(--t-base);
  }

  :global(.animated) .replay {
    display: inline-flex;
  }

  .replay:hover {
    color: var(--gold-light);
  }

  .replay .icon {
    width: 0.95rem;
    height: 0.95rem;
    transition: transform 0.6s var(--ease-out);
  }

  .replay:hover .icon {
    transform: rotate(-200deg);
  }

  /* wskazówka przewijania: cienka linia, po której przesuwa się złote światło */
  .hero__scroll {
    position: absolute;
    z-index: 2;
    bottom: 0;
    left: 50%;
    width: 2.75rem;
    height: clamp(3rem, 7svh, 4.5rem);
    translate: -50% 0;
  }

  .hero__scroll::before,
  .hero__scroll::after {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 1px;
    height: 100%;
    background: var(--line);
  }

  .hero__scroll::after {
    background: linear-gradient(transparent, var(--gold-mid), transparent);
    animation: scroll-cue 2.4s var(--ease-in-out) infinite;
  }

  @keyframes scroll-cue {
    0% {
      clip-path: inset(0 0 100% 0);
    }

    50% {
      clip-path: inset(0);
    }

    100% {
      clip-path: inset(100% 0 0 0);
    }
  }

  /* przed lądowaniem ptaka treść jest ukryta (klasy z boot.js i intro.js) */
  :global(.intro) .reveal {
    opacity: 0;
  }

  @media (height <= 700px) and (width >= 700px) {
    .hero__scroll {
      display: none;
    }
  }

  /* niski ekran laptopa: ciaśniejsze odstępy i mniejszy sygnet, żeby przyciski były widoczne bez przewijania */
  @media (width >= 36rem) and (height < 62rem) {
    .hero {
      padding-block: var(--header-h) 2.5rem;
    }

    .hero :global(.mark) {
      width: clamp(6.5rem, 19svh, 12rem);
    }

    .lettering {
      margin-top: clamp(0.75rem, 2svh, 1.5rem);
    }

    .divider {
      margin-block: clamp(1rem, 2.4svh, 1.75rem);
    }

    .hero__title {
      font-size: min(clamp(2.2rem, 1.5rem + 3.2vw, 4.4rem), 7svh);
    }

    .hero__lead {
      margin-top: clamp(0.75rem, 1.6svh, 1.25rem);
    }

    .hero__actions {
      margin-top: clamp(1.25rem, 3svh, 2rem);
    }
  }

  /* telefon: mniejszy sygnet i napisy, żeby przyciski zmieściły się na pierwszym ekranie */
  @media (width < 36rem) {
    .hero {
      padding-bottom: 3.5rem;
    }

    .lettering__name {
      font-size: 1.6rem;
    }

    .lettering__brand {
      gap: 0.8rem;
      margin-top: 0.7rem;
      font-size: 0.72rem;
    }

    .lettering__brand::before,
    .lettering__brand::after {
      width: 2.25rem;
    }

    .lettering__tagline {
      font-size: 0.62rem;
      letter-spacing: 0.24em;
    }

    .hero__lead {
      font-size: 1.05rem;
    }

    .hero__actions {
      gap: 0.75rem;
    }

    .hero__actions :global(.btn) {
      padding-inline: 1.25rem;
      font-size: 0.72rem;
    }

    .hero__scroll {
      display: none;
    }
  }

  /* mały telefon (np. iPhone SE): jeszcze ciaśniej */
  @media (width < 36rem) and (height < 48rem) {
    .hero {
      padding-top: 4.75rem;
    }

    .hero :global(.mark) {
      width: 5.5rem;
    }

    .lettering {
      margin-top: 0.9rem;
    }

    .lettering__name {
      font-size: 1.45rem;
    }

    .divider {
      margin-block: 1.1rem;
    }

    .hero__title {
      font-size: 2rem;
    }

    .hero__lead {
      font-size: 1rem;
    }

    .hero__actions {
      margin-top: 1.4rem;
    }
  }
</style>
