---
import { categories } from '../../data/oferta';
import CategoryList from '../CategoryList.astro';
---

<section id="oferta" class="section" aria-labelledby="offer-title">
  <div class="container split">
    <div class="split__aside">
      <p class="label" data-reveal>
        Oferta
      </p>
    </div>
    <div>
      <h2 id="offer-title" class="h2" data-split>
        Zabiegi, które dobieram do Ciebie
      </h2>
      <p class="offer__intro lead" data-reveal>
        Cztery obszary pielęgnacji, od skóry głowy po dłonie. Wybierz to, co Cię interesuje, a na podstronie
        przeczytasz, jak wygląda każdy zabieg i ile trwa.
      </p>
      <CategoryList categories={categories} detail="teaser" />
    </div>
  </div>
</section>

<style>
  .offer__intro {
    max-width: 40rem;
    margin-block: clamp(1.5rem, 3vw, 2.25rem) clamp(2.5rem, 5vw, 3.5rem);
  }
</style>
