---
import Icon from './Icon.astro';
import { NEW_TAB } from '../../data/salon';

interface Props {
  href: string;
  variant?: 'gold' | 'gold-outline' | 'ink' | 'ink-outline';
  size?: 'normal' | 'small';
  arrow?: boolean;
  /** odnośnik do innej witryny: otwiera się w nowej karcie */
  external?: boolean;
  class?: string;
}

const { href, variant = 'gold', size = 'normal', arrow = false, external = false, class: className } = Astro.props;
---

<a
  class:list={['btn', `btn--${variant}`, { 'btn--small': size === 'small' }, className]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
>
  <slot />
  {arrow && <Icon name="arrow" class="btn__arrow" />}
  {external && <span class="visually-hidden">{NEW_TAB}</span>}
</a>
