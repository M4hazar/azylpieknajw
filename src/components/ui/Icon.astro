---
// Ikony liniowe w jednym stylu (kreska 1,4 px, zaokrąglone końce). Dekoracyjne: zawsze z aria-hidden.
const paths = {
  arrow: 'M1 8h20M15 2l6 6-6 6',
  'arrow-left': 'M23 8H3M9 2 3 8l6 6',
  'arrow-up': 'M12 21V3M6 9l6-6 6 6',
  chevron: 'm6 9 6 6 6-6',
  close: 'M5 5l14 14M19 5 5 19',
  pin: 'M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Zm0-9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  phone:
    'M5.5 3h3l1.6 4.2-2 1.3a11 11 0 0 0 5.4 5.4l1.3-2L19 13.5v3A2.5 2.5 0 0 1 16.5 19 13.5 13.5 0 0 1 3 5.5 2.5 2.5 0 0 1 5.5 3Z',
  instagram:
    'M7.5 3h9A4.5 4.5 0 0 1 21 7.5v9a4.5 4.5 0 0 1-4.5 4.5h-9A4.5 4.5 0 0 1 3 16.5v-9A4.5 4.5 0 0 1 7.5 3ZM12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm5-9.5h.01',
  calendar:
    'M4 6.5A1.5 1.5 0 0 1 5.5 5h13A1.5 1.5 0 0 1 20 6.5v12a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5v-12ZM4 10h16M8.5 3v4M15.5 3v4',
  replay: 'M3.5 12a8.5 8.5 0 1 0 2.6-6.1M3.5 3.5v4.6h4.6',
} as const;

const viewBoxes: Partial<Record<keyof typeof paths, string>> = {
  arrow: '0 0 22 16',
  'arrow-left': '0 0 24 16',
};

interface Props {
  name: keyof typeof paths;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  viewBox={viewBoxes[name] ?? '0 0 24 24'}
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]}></path>
</svg>
