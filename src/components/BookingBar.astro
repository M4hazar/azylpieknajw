---
// Pasek rezerwacji na telefonie: pojawia się po przewinięciu początku strony i chowa przy stopce,
// w której jest duży przycisk rezerwacji (src/scripts/ui.ts).
import Icon from './ui/Icon.astro';
import { salon, NEW_TAB } from '../data/salon';
---

<div class="booking-bar" data-booking-bar>
  <a class="booking-bar__link" href={salon.booksy} target="_blank" rel="noopener">
    <Icon name="calendar" />
    Umów wizytę
    <span class="booking-bar__via">w Booksy</span>
    <span class="visually-hidden"> {NEW_TAB}</span>
  </a>
</div>

<style>
  .booking-bar {
    position: fixed;
    z-index: 45;
    right: 0;
    bottom: 0;
    left: 0;
    display: none;
    padding: 0.625rem var(--gutter) calc(0.625rem + env(safe-area-inset-bottom));
    pointer-events: none;
    translate: 0 110%;
    transition: translate 0.5s var(--ease-out);
  }

  .booking-bar[data-visible] {
    translate: 0;
  }

  .booking-bar__link {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    border: 1px solid rgb(210 174 106 / 55%);
    background: rgb(30 19 11 / 90%);
    backdrop-filter: blur(10px);
    box-shadow: 0 10px 30px -12px rgb(30 19 11 / 50%);
    color: var(--gold-light);
    font-family: var(--f-label);
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-decoration: none;
    text-transform: uppercase;
    pointer-events: auto;
  }

  .booking-bar__link:active {
    background: var(--gold-light);
    color: var(--night);
  }

  .booking-bar__link .icon {
    width: 1.1rem;
  }

  .booking-bar__via {
    color: var(--mute-dark);
    letter-spacing: 0.12em;
    text-transform: none;
  }

  @media (width < 60rem) {
    .booking-bar {
      display: block;
    }
  }

  :global(.intro) .booking-bar {
    visibility: hidden;
  }
</style>
